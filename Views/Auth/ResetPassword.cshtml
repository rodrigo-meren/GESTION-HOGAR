@model TPI_GESTION_HOGAR.ViewModel.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-primary"><i class="bi bi-shield-lock"></i> Restablecer Contraseña</h3>

                    @if (ViewBag.IsError == true)
                    {
                        <div class="alert alert-danger fw-bold">
                            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Message
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">Nueva Contraseña</label>
                            <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirmar Contraseña</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repetí la contraseña" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-bold">
                                Guardar Nueva Contraseña
                            </button>
                            <a asp-action="Login" class="btn btn-outline-secondary">Volver al inicio de sesión</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}